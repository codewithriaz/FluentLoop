{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluentLoop",
  "version": "0.1.0",
  "identifier": "com.fluentloop.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FluentLoop",
        "width": 1360,
        "height": 860,
        "minWidth": 400,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://www.youtube.com https://s.ytimg.com",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost blob: mediastream:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Local-first English immersion workspace",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
